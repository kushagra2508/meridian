# Copy to .env and fill in. .env is gitignored.

# OpenRouter key (https://openrouter.ai/keys). LiteLLM picks this up for any
# model prefixed with `openrouter/`.
OPENROUTER_API_KEY=

# Any LiteLLM-resolvable model string. Cheap default for smoke tests.
MERIDIAN_LLM_MODEL=openrouter/openai/gpt-5-mini

# Optional attribution headers OpenRouter shows on your dashboard.
OR_SITE_URL=http://localhost:5173
OR_APP_NAME=Meridian Feasibility Agent
